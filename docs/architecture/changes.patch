@@ -0,0 +1,44 @@
+import Link from 'next/link'
+import { requireAdmin } from '../../../lib/auth'
+import { createSupabaseServerClient } from '../../../lib/supabase-server'
+import { uuid } from '../../../lib/decision-engine-contract'
+export const dynamic = 'force-dynamic'
+const concepts: { type: string; label: string; status?: string }[] = [
+  { type: 'market_signal', label: 'Signals' }, { type: 'intelligence_report', label: 'Research reports' },
+  { type: 'prediction', label: 'Predictions' }, { type: 'recommendation', label: 'Recommendations' },
+  { type: 'recommendation', label: 'Awaiting approval', status: 'RECOMMENDED' },
+  { type: 'execution_request', label: 'Execution requests' },
+  { type: 'execution_request', label: 'Running executions', status: 'RUNNING' },
+  { type: 'execution_result', label: 'Completed results', status: 'COMPLETED' },
+  { type: 'execution_result', label: 'Failed results', status: 'FAILED' },
+  { type: 'feedback_evaluation', label: 'Feedback evaluations' },
+]
+export default async function ServicesPage({ searchParams }: { searchParams: Promise<{ organization_id?: string }> }) {
+  await requireAdmin()
+  const params = await searchParams
+  const org = params.organization_id ? uuid.safeParse(params.organization_id) : null
+  if (org && !org.success) return <p>Invalid organization ID.</p>
+  const db = await createSupabaseServerClient()
+  const { data: services, error } = await db.from('service_registry').select('service_id,display_name,enabled').order('display_name')
+  if (error) return <p role="alert">Service catalog could not be loaded.</p>
+  const cards = await Promise.all((services ?? []).map(async service => {
+    const counts = await Promise.all(concepts.map(async concept => {
+      let query = db.from('service_record_lineage').select('id', { count: 'exact', head: true }).eq('service_id', service.service_id).eq('record_type', concept.type)
+      if (concept.status) query = query.eq('status', concept.status)
+      if (org?.success) query = query.eq('organization_id', org.data)
+      const result = await query
+      return { label: concept.label, count: result.error ? null : result.count }
+    }))
+    return { ...service, counts }
+  }))
+  return <div><h1 className="text-3xl font-bold">Services</h1>
+    <p>Research, recommendations and outcomes linked to a service. Older records without explicit service identity remain on their existing pages.</p>
+    <form className="my-4"><label>Organization ID <input className="input" name="organization_id" defaultValue={params.organization_id} /></label><button className="btn">Filter</button></form>
+    {cards.map(service => <article className="card p-5 my-4" key={service.service_id}>
+      <h2 className="text-xl font-semibold">{service.display_name}</h2>
+      <p>{service.enabled ? 'Registered · execution remains subject to approval and adapter availability' : 'Not enabled'}</p>
+      <dl>{service.counts.map(({ label, count }) => <div key={label}><dt className="inline capitalize">{label}: </dt><dd className="inline">{count ?? 'Unavailable'}</dd></div>)}</dl>
+    </article>)}
+    <Link href={org?.success ? `/admin/recommendations?organization_id=${org.data}` : '/admin/recommendations'}>Review recommendations</Link>
+  </div>
+}
