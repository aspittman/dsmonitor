--- devspace-crm/supabase/migrations/019_service_context.sql
+++ devspace-crm/supabase/migrations/019_service_context.sql
@@ -0,0 +1,134 @@
+-- Additive identity contract. Existing business records and RPCs remain authoritative.
+begin;
+create table service_registry (
+ service_id text primary key, display_name text not null, enabled boolean not null default false,
+ workflow_type text unique, applicable_engines text[] not null default '{}',
+ approval_required boolean not null default true, organization_scope text not null default 'organization',
+ metadata jsonb not null default '{}'
+);
+create table service_aliases (
+ alias text primary key, service_id text not null references service_registry(service_id)
+);
+insert into service_registry(service_id,display_name,enabled,workflow_type,applicable_engines) values
+ ('domain_merchant','Domain Merchant',true,'domain',array['mmonolith','decision_engine','dsorchestrator','devspace_one']),
+ ('scholarship_research','Scholarship Research',false,null,array['mmonolith','decision_engine','dsorchestrator','devspace_one']),
+ ('devspace_services','DevSpace Services',false,'devspace-services',array['mmonolith','decision_engine','dsorchestrator','devspace_one']),
+ ('devspace_clients','DevSpace Clients',false,'crm-companies',array['mmonolith','decision_engine','dsorchestrator','devspace_one']),
+ ('investor_research','Investor Research',false,null,array['mmonolith','decision_engine','dsorchestrator','devspace_one']);
+insert into service_aliases values ('domain','domain_merchant'),('scholarship','scholarship_research'),
+ ('scholorship_research','scholarship_research'),('devspace-services','devspace_services'),
+ ('crm-companies','devspace_clients'),('crm_business','devspace_clients');
+alter table service_registry enable row level security;
+alter table service_aliases enable row level security;
+revoke all on service_registry,service_aliases from public,anon,authenticated;
+grant select on service_registry,service_aliases to authenticated;
+grant all on service_registry,service_aliases to service_role;
+create policy service_catalog_read on service_registry for select to authenticated using(true);
+create policy service_alias_read on service_aliases for select to authenticated using(true);
+create function canonical_service_id(value text) returns text language sql stable set search_path=public,pg_temp as $$
+ select coalesce((select service_id from service_registry where service_id=value),
+                 (select service_id from service_aliases where alias=value),
+                 (select service_id from service_registry where workflow_type=value))
+$$;
+
+-- Reuse dsorchestrator's exact existing tables, including installations that predate this migration.
+CREATE TABLE IF NOT EXISTS workflow_runs (
+ id TEXT PRIMARY KEY, workflow_type TEXT NOT NULL, organization_id TEXT NOT NULL,
+ cycle_key TEXT NOT NULL, status TEXT NOT NULL, current_stage TEXT,
+ correlation_id TEXT NOT NULL, created_at DOUBLE PRECISION NOT NULL,
+ updated_at DOUBLE PRECISION NOT NULL, completed_at DOUBLE PRECISION,
+ error_message TEXT, metadata TEXT NOT NULL,
+ UNIQUE(workflow_type, organization_id, cycle_key));
+CREATE TABLE IF NOT EXISTS stage_runs (
+ id TEXT PRIMARY KEY, workflow_run_id TEXT NOT NULL REFERENCES workflow_runs(id),
+ stage TEXT NOT NULL, engine TEXT NOT NULL, status TEXT NOT NULL,
+ attempt INTEGER NOT NULL DEFAULT 0, started_at DOUBLE PRECISION, completed_at DOUBLE PRECISION,
+ claim_token TEXT, claimed_by TEXT, input_reference TEXT NOT NULL DEFAULT '{}',
+ output_reference TEXT NOT NULL DEFAULT '{}', error_message TEXT, retry_safe INTEGER NOT NULL DEFAULT 0,
+ UNIQUE(workflow_run_id,stage));
+create index if not exists ds_stage_queue on stage_runs(status,engine);
+alter table workflow_runs add column service_id text references service_registry(service_id),
+ add column parent_run_id text references workflow_runs(id);
+-- A parent is backend-only coordination metadata, never a synthetic customer organization.
+alter table workflow_runs alter column organization_id drop not null;
+alter table workflow_runs add constraint workflow_parent_scope check
+ (organization_id is not null or (workflow_type='crm-companies' and coalesce(metadata::jsonb->>'scope'='parent',false)));
+create unique index workflow_parent_cycle on workflow_runs(workflow_type,cycle_key) where organization_id is null;
+create index workflow_parent_lookup on workflow_runs(parent_run_id);
+alter table workflow_runs enable row level security;
+alter table stage_runs enable row level security;
+revoke all on workflow_runs,stage_runs from public,anon,authenticated;
+grant all on workflow_runs,stage_runs to service_role;
+
+-- Enforce tenant/parent identity at the authoritative coordination store.
+create function validate_workflow_identity() returns trigger language plpgsql set search_path=public,pg_temp as $$
+declare parent workflow_runs;
+begin
+ if new.organization_id is not null and not exists(select 1 from organizations where id::text=new.organization_id) then
+   raise exception 'Unknown workflow organization'; end if;
+ if new.service_id is not null and canonical_service_id(new.workflow_type) is distinct from new.service_id then
+   raise exception 'Workflow/service mismatch'; end if;
+ if new.parent_run_id is not null then
+   select * into parent from workflow_runs where id=new.parent_run_id;
+   if not found or parent.organization_id is not null or parent.workflow_type<>'crm-companies'
+      or new.workflow_type<>'crm-companies' or new.organization_id is null then raise exception 'Invalid parent scope'; end if;
+ end if;
+ if tg_op='UPDATE' and (new.organization_id is distinct from old.organization_id
+    or new.parent_run_id is distinct from old.parent_run_id or new.service_id is distinct from old.service_id
+    or new.workflow_type is distinct from old.workflow_type) then raise exception 'Workflow ownership is immutable'; end if;
+ return new;
+end $$;
+create trigger workflow_identity before insert or update on workflow_runs for each row execute function validate_workflow_identity();
+revoke all on function validate_workflow_identity() from public,anon,authenticated;
+
+-- Explicit context lives on root evidence and recommendations. Descendants inherit through existing FKs.
+alter table intelligence_reports add column service_id text references service_registry(service_id), add column workflow_run_id text references workflow_runs(id);
+alter table recommendations add column service_id text references service_registry(service_id), add column workflow_run_id text references workflow_runs(id);
+create index report_service on intelligence_reports(service_id,organization_id);
+create index recommendation_service on recommendations(service_id,organization_id);
+create index report_workflow on intelligence_reports(organization_id,workflow_run_id);
+create index recommendation_workflow on recommendations(organization_id,workflow_run_id);
+create function validate_record_context() returns trigger language plpgsql set search_path=public,pg_temp as $$
+declare c jsonb; w workflow_runs; canonical text;
+begin
+ c:=new.metadata->'workflow_context';
+ if c is null then
+   if new.workflow_run_id is not null or new.service_id is not null then raise exception 'Explicit workflow context required'; end if;
+   return new;
+ end if; -- historical / legacy producers stay supported; no invented lineage
+ canonical:=canonical_service_id(c->>'service_id');
+ if canonical is null or nullif(c->>'workflow_run_id','') is null
+    or c->>'organization_id' is distinct from new.organization_id::text then raise exception 'Invalid workflow context'; end if;
+ select * into w from workflow_runs where id=c->>'workflow_run_id';
+ if not found or w.organization_id is distinct from new.organization_id::text
+    or coalesce(w.service_id,canonical_service_id(w.workflow_type)) is distinct from canonical
+    or w.parent_run_id is distinct from c->>'parent_run_id'
+    or w.correlation_id is distinct from c->>'correlation_id' then raise exception 'Foreign workflow context'; end if;
+ if c->>'source_engine' is distinct from (case when tg_table_name='intelligence_reports' then 'mmonolith' else 'decision_engine' end)
+    then raise exception 'Invalid primary writer'; end if;
+ new.service_id:=canonical; new.workflow_run_id:=w.id;
+ return new;
+end $$;
+create trigger report_workflow_context before insert on intelligence_reports for each row execute function validate_record_context();
+create trigger recommendation_workflow_context before insert on recommendations for each row execute function validate_record_context();
+-- New identity cannot be rewritten by a later status update.
+create function preserve_record_context() returns trigger language plpgsql as $$ begin
+ if new.service_id is distinct from old.service_id or new.workflow_run_id is distinct from old.workflow_run_id
+    or new.metadata->'workflow_context' is distinct from old.metadata->'workflow_context' then
+ raise exception 'Workflow identity is immutable'; end if; return new; end $$;
+create trigger report_identity before update on intelligence_reports for each row execute function preserve_record_context();
+create trigger recommendation_identity before update on recommendations for each row execute function preserve_record_context();
+revoke all on function validate_record_context(),preserve_record_context() from public,anon,authenticated;
+
+-- One reusable tenant-filtered projection; no copied outcome/history tables or synthetic legacy links.
+create view service_record_lineage with (security_invoker=true) as
+ select 'intelligence_report'::text record_type,r.id,r.organization_id,r.service_id,r.workflow_run_id,'mmonolith'::text source_engine,r.created_at,r.status from intelligence_reports r
+ union all select distinct 'market_signal',s.id,s.organization_id,r.service_id,r.workflow_run_id,'mmonolith',s.created_at,null from market_signals s join intelligence_report_signals l on l.signal_id=s.id and l.organization_id=s.organization_id join intelligence_reports r on r.id=l.report_id and r.organization_id=l.organization_id
+ union all select 'prediction',p.id,p.organization_id,r.service_id,r.workflow_run_id,'mmonolith',p.created_at,p.status from predictions p join intelligence_reports r on r.id=p.intelligence_report_id and r.organization_id=p.organization_id
+ union all select 'recommendation',r.id,r.organization_id,r.service_id,r.workflow_run_id,'decision_engine',r.created_at,r.status from recommendations r
+ union all select 'execution_request',q.id,q.organization_id,r.service_id,r.workflow_run_id,'crm',q.created_at,q.status from execution_requests q join recommendations r on r.id=q.recommendation_id and r.organization_id=q.organization_id
+ union all select 'execution_result',x.id,x.organization_id,r.service_id,r.workflow_run_id,'devspace_one',x.created_at,x.status from execution_results x join execution_requests q on q.id=x.execution_request_id and q.organization_id=x.organization_id join recommendations r on r.id=q.recommendation_id and r.organization_id=q.organization_id
+ union all select 'feedback_evaluation',f.id,f.organization_id,r.service_id,r.workflow_run_id,'mmonolith',f.created_at,f.evaluation from feedback_evaluations f join intelligence_reports r on r.id=f.intelligence_report_id and r.organization_id=f.organization_id;
+revoke all on service_record_lineage from public,anon,authenticated;
+grant select on service_record_lineage to authenticated,service_role;
+commit;
--- devspace-crm/supabase/migrations/020_legacy_tenant_reads.sql
+++ devspace-crm/supabase/migrations/020_legacy_tenant_reads.sql
@@ -0,0 +1,23 @@
+-- Close missing RLS coverage while retaining server-role ingestion and admin management.
+-- Legacy rows with unknown tenant ownership remain admin-only; do not infer/backfill owners.
+begin;
+do $$ declare t text; begin
+ foreach t in array array['organizations','organization_services','organization_members','organization_business_groups','contacts','sales_records','lead_notes','activity_log'] loop
+ execute format('alter table %I enable row level security',t);
+ execute format('revoke all on %I from anon',t);
+ execute format('grant select,insert,update,delete on %I to authenticated',t);
+ execute format('create policy architecture_admin on %I for all to authenticated using (is_admin()) with check (is_admin())',t);
+ if t='organizations' then
+ execute 'create policy architecture_tenant_read on organizations for select to authenticated using (id=my_org_id())';
+ else
+ execute format('create policy architecture_tenant_read on %I for select to authenticated using (organization_id=my_org_id())',t);
+ end if;
+ end loop;
+end $$;
+-- Existing CRM sales entry is tenant-scoped; do not grant customer contact/config writes.
+grant insert,update on sales_records to authenticated;
+create policy architecture_sales_insert on sales_records for insert to authenticated with check
+ (organization_id=my_org_id() and (lead_id is null or exists(select 1 from leads where id=lead_id and organization_id=my_org_id())));
+create policy architecture_sales_update on sales_records for update to authenticated using (organization_id=my_org_id()) with check
+ (organization_id=my_org_id() and (lead_id is null or exists(select 1 from leads where id=lead_id and organization_id=my_org_id())));
+commit;
