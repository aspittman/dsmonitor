# Defaults discover adjacent projects. Copy to .env only for overrides.
DSMONITOR_PORT=5055
DSMONITOR_REFRESH_SECONDS=10
DSMONITOR_SNAPSHOT_SECONDS=120
DSMONITOR_CRM_CONTEXT_SECONDS=120
DSMONITOR_RETENTION_DAYS=30
DSMONITOR_TIMEOUT_SECONDS=3
DSMONITOR_LIMIT=200
# Existing CRM URL/token and Supabase URL/anon key are read server-side from
# ../devspace-one/.env and ../devspace-crm/.env.local when not overridden.
# Explicit blanks disable discovery of that source.
# DSMONITOR_CRM_URL=https://your-crm.example
# DSMONITOR_CRM_TOKEN=your-server-side-read-credential
# DSMONITOR_SUPABASE_URL=https://your-project.supabase.co
# DSMONITOR_SUPABASE_KEY=your-anon-or-read-only-key
# Optional independent read-only PostgreSQL credential (never printed).
# DSMONITOR_SUPABASE_DSN=postgresql://monitor:password@host/database
# Local SQLite is default. For production shared orchestration state:
# DSMONITOR_ORCHESTRATOR_DSN=postgresql://monitor:password@host/database
# Remote workflow/CRM reads require explicit tenant scope.
DSMONITOR_ORGANIZATION_IDS=[]
# Set thresholds only after observing/documenting expected stage runtimes.
DSMONITOR_STALE_SECONDS={}
# Example: {"domain":{"execution":600}}
DSMONITOR_HEALTH_URLS={}
# Example: {"decision_engine":"http://127.0.0.1:8001/health"}
DSMONITOR_HEARTBEAT_FILES={}
# Optional JSON heartbeat: {"timestamp":"2026-09-17T12:00:00Z"}
DSMONITOR_HEARTBEAT_MAX_AGE=120
DSMONITOR_EXTRA_PROCESSES=[]
# [{"id":"google_play","display_name":"Google Play","aliases":[],"note":"..."}]

# Optional captured stdout / nonstandard engine log files.
DSMONITOR_LOG_FILES={}
# {"decision_engine":["/path/to/decision-engine.jsonl"]}
# Set only when you know the timezone used by naive local log timestamps.
DSMONITOR_LOG_TIMEZONE=
# Example: America/Denver

# Trace registry overrides are ordered sequential paths, not operational routing.
# Never add expected stages solely to make a dashboard look complete.
DSMONITOR_TRACE_REGISTRY={}
# Thresholds are opt-in; human approval waits never become stalled.
# Example: {"domain_merchant":{"devspace_one":{"execution":{"expected_seconds":600,"stalled_seconds":1200}}}}
DSMONITOR_TRACE_THRESHOLDS={}
# Optional structured source files emitted with the same context across engines.
# Example: {"mmonolith":"/absolute/path/mmonolith-traces.jsonl"}
DSMONITOR_TRACE_FILES={}
DSMONITOR_TRACE_LIMIT=1000

# Current capability: CRM API / independent Supabase cache and max engine-report age.
# CRM tenant history continues to use DSMONITOR_CRM_CONTEXT_SECONDS (120 by default).
DSMONITOR_CAPABILITY_SECONDS=60
# Real source write evidence expires independently of activity/scheduling expectations.
DSMONITOR_WRITE_EVIDENCE_SECONDS=86400
# Service monitoring contracts: engines.{engine}.inputs / outputs / dependencies.
# Optional trace_thresholds.{service}.{engine}.activity:
# {"expected_interval":86400,"anchor_at":"2026-10-01T09:30:00-06:00","late_threshold":900}
# This is a fixed interval from an explicit anchor, not a timezone-aware cron rule.
# Optional trace_thresholds.{service}.handoffs.{edge_id}.stalled_seconds=900
# No default schedule or handoff deadline is guessed. See docs/SERVICE_HEALTH_UPGRADE_REPORT.md.
